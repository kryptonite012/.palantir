# Project Atlas configuration. Values below are safe examples, not production secrets.
ATLAS_APP_NAME=Project Atlas
ATLAS_ENV=development                 # development | test | production
ATLAS_OFFLINE_MODE=true               # installs the outbound network guard; keep true for air-gapped use
ATLAS_HOST=127.0.0.1                  # loopback by default; LAN requires ATLAS_ALLOW_LAN=true
ATLAS_PORT=8000
ATLAS_DATABASE_URL=                   # empty = SQLite in ATLAS_STORAGE_DIR (atlas_dev / atlas_test / atlas_prod)
ATLAS_STORAGE_DIR=./atlas-workspace
ATLAS_BACKUP_DIR=./atlas-backups
ATLAS_AI_ENABLED=false
ATLAS_AI_BASE_URL=                    # e.g. http://127.0.0.1:11434 (Ollama); must be loopback/private in offline mode
ATLAS_MODEL_DIR=./models
ATLAS_TELEMETRY_ENABLED=false         # telemetry is not implemented; true is rejected at startup
ATLAS_LOG_LEVEL=INFO

# Optional
ATLAS_SESSION_TTL_MINUTES=480
ATLAS_MAX_UPLOAD_MB=200
ATLAS_JOBS_INLINE=false
ATLAS_ALLOW_LAN=false
ATLAS_TLS_TERMINATED=false            # set true only behind a TLS-terminating reverse proxy (required for LAN production)
ATLAS_QUERY_TIMEOUT_SECONDS=20
ATLAS_QUERY_ROW_LIMIT=5000
ATLAS_GRAPH_NODE_LIMIT=2000
ATLAS_BACKUP_INTERVAL_HOURS=0         # 0 disables scheduled backups
ATLAS_FRONTEND_DIST=                  # defaults to ../frontend/dist or the bundled static directory
