# Project Atlas configuration. Values below are safe examples, not production secrets.
# Process environment variables override this file. Comments must be on their own lines.

ATLAS_APP_NAME=Project Atlas
# development | test | production
ATLAS_ENV=development
# Installs the outbound network guard; keep true for air-gapped use
ATLAS_OFFLINE_MODE=true
# Loopback by default; any other address requires ATLAS_ALLOW_LAN=true
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
# Empty = SQLite in ATLAS_STORAGE_DIR (atlas_dev / atlas_test / atlas_prod by ATLAS_ENV)
ATLAS_DATABASE_URL=
ATLAS_STORAGE_DIR=./atlas-workspace
ATLAS_BACKUP_DIR=./atlas-backups
ATLAS_AI_ENABLED=false
# e.g. http://127.0.0.1:11434 (Ollama); must be loopback/private in offline mode
ATLAS_AI_BASE_URL=
ATLAS_MODEL_DIR=./models
# Telemetry is not implemented; true is rejected at startup
ATLAS_TELEMETRY_ENABLED=false
ATLAS_LOG_LEVEL=INFO

# Optional settings
ATLAS_SESSION_TTL_MINUTES=480
ATLAS_MAX_UPLOAD_MB=200
ATLAS_JOBS_INLINE=false
ATLAS_ALLOW_LAN=false
# Set true only behind a TLS-terminating reverse proxy (required for LAN production)
ATLAS_TLS_TERMINATED=false
ATLAS_QUERY_TIMEOUT_SECONDS=20
ATLAS_QUERY_ROW_LIMIT=5000
ATLAS_GRAPH_NODE_LIMIT=2000
# 0 disables scheduled backups
ATLAS_BACKUP_INTERVAL_HOURS=0
ATLAS_BACKUP_RETENTION=10
# Defaults to the UI bundled in the package, or ../frontend/dist in a source checkout
ATLAS_FRONTEND_DIST=
